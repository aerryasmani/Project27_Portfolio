---
// Icon-only theme toggle (44px square, same look as the menu's × button).
// Light shows a pixel moon (action: go dark); dark shows a pixel sun (action: go light).
// Every instance on the page is kept in sync by the script below.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  aria-label="Switch to dark mode"
  aria-pressed="false"
  class:list={[
    'flex size-11 flex-none items-center justify-center rounded-btn border-2 border-line bg-surface text-ink hover:bg-surface-2',
    className,
  ]}
>
  <svg aria-hidden="true" class="size-6 dark:hidden" viewBox="0 0 12 12" shape-rendering="crispEdges" fill="currentColor">
    <path d="M3 1h2v1h-2zM2 2h3v1h-3zM1 3h3v1h-3zM1 4h3v1h-3zM1 5h4v1h-4zM1 6h5v1h-5zM1 7h6v1h-6zM10 7h1v1h-1zM1 8h10v1h-10zM2 9h8v1h-8zM3 10h6v1h-6z"></path>
  </svg>
  <svg aria-hidden="true" class="hidden size-6 dark:block" viewBox="0 0 12 12" shape-rendering="crispEdges" fill="currentColor">
    <path d="M5 0h2v1h-2zM1 1h1v1h-1zM5 1h2v1h-2zM10 1h1v1h-1zM2 2h1v1h-1zM9 2h1v1h-1zM4 3h4v1h-4zM3 4h6v1h-6zM0 5h2v1h-2zM3 5h6v1h-6zM10 5h2v1h-2zM0 6h2v1h-2zM3 6h6v1h-6zM10 6h2v1h-2zM3 7h6v1h-6zM4 8h4v1h-4zM2 9h1v1h-1zM9 9h1v1h-1zM1 10h1v1h-1zM5 10h2v1h-2zM10 10h1v1h-1zM5 11h2v1h-2z"></path>
  </svg>
</button>

<script>
  // Flip data-theme, save the choice, keep labels / aria-pressed / theme-color in sync.
  // Default is light; only an explicit choice ('dark' in localStorage) changes it (see Base.astro).
  const root = document.documentElement;
  const toggles = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
  const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');

  const apply = (theme: 'light' | 'dark') => {
    root.dataset.theme = theme;
    const dark = theme === 'dark';
    for (const t of toggles) {
      t.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
      t.setAttribute('aria-pressed', String(dark));
    }
    if (meta) meta.content = dark ? '#11131C' : '#F2EEE3';
  };

  apply(root.dataset.theme === 'dark' ? 'dark' : 'light');
  for (const t of toggles) {
    t.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      apply(next);
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* storage unavailable — choice lasts for this page only */
      }
    });
  }
</script>
