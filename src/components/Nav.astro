---
import Tab from './Tab.astro';

const links = [
  { href: '/#work', label: 'Work' },
  { href: '/#experience', label: 'Experience' },
  { href: '/#stack', label: 'Stack' },
  { href: '/#writing', label: 'Writing' },
  { href: '/#contact', label: 'Contact', on: true },
];
---

<header class="flex flex-wrap items-center justify-between gap-4 pt-4">
  <a href="/" class="px text-[22px] text-ink no-underline">
    HEIYOAERRY.ONE<span class="blink" aria-hidden="true">_</span>
  </a>
  <nav aria-label="Primary" class="grid w-full grid-cols-2 pr-0.5 pb-0.5 sm:flex sm:flex-nowrap sm:pr-0 sm:pl-0.5 md:w-auto">
    {links.map((l) => <Tab href={l.href} on={l.on} class="flex-none max-sm:ml-0 max-sm:-mr-0.5 max-sm:px-2 max-sm:last:col-span-full">{l.label}</Tab>)}
  </nav>
</header>
