---
import Tab from './Tab.astro';

const links = [
  { href: '/#work', label: 'Work' },
  { href: '/#experience', label: 'Experience' },
  { href: '/#stack', label: 'Stack' },
  { href: '/#writing', label: 'Writing' },
  { href: '/#contact', label: 'Contact', on: true },
];
---

<header class="flex flex-wrap items-center justify-between gap-4 pt-4">
  <a href="/" class="px text-[22px] text-ink no-underline">
    HEIYOAERRY.ONE<span class="blink" aria-hidden="true">_</span>
  </a>
  <nav aria-label="Primary" class="flex w-full flex-nowrap overflow-x-auto pb-0.5 pl-0.5 md:w-auto md:overflow-visible">
    {links.map((l) => <Tab href={l.href} on={l.on} class="flex-none max-md:focus-visible:outline-offset-[-6px]">{l.label}</Tab>)}
  </nav>
</header>
