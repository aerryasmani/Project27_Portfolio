---
import Tab from './Tab.astro';
import WindowCard from './WindowCard.astro';
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: '/#work', label: 'Work' },
  { href: '/#experience', label: 'Experience' },
  { href: '/#stack', label: 'Stack' },
  { href: '/#writing', label: 'Writing' },
  { href: '/#contact', label: 'Contact', on: true },
];
---

<!--
  Phones: one row — logo (shrinks via clamp) left, Menu right. The theme toggle lives in the menu panel.
  640px+: logo, then the tab row + icon toggle (own row below 1024px, beside the logo from 1024px).
-->
<header
  class="relative flex flex-nowrap items-center justify-between gap-3 pt-4 sm:flex-wrap sm:justify-start sm:gap-x-2 sm:gap-y-4"
>
  <a href="/" class="px min-w-0 text-[clamp(16px,4.6vw,22px)] whitespace-nowrap text-ink no-underline sm:mr-auto">
    HEIYOAERRY.ONE<span class="blink" aria-hidden="true">_</span>
  </a>

  <!-- Phones: menu button + popover panel -->
  <button
    type="button"
    id="menu-button"
    aria-expanded="false"
    aria-controls="mobile-menu"
    class="inline-flex min-h-11 flex-none items-center rounded-btn border-2 border-line bg-surface px-3 text-sm font-semibold text-ink aria-expanded:bg-surface-2 sm:hidden"
  >
    [ <span aria-hidden="true" class="mx-1 text-xl leading-none">≡</span> Menu ]
  </button>

  <div id="mobile-menu" hidden class="menu-pop absolute inset-x-0 top-full z-20 mt-3 sm:hidden">
    <WindowCard title="MENU">
      <div slot="badge" class="-my-2 -mr-1.5 flex items-center gap-2">
        <ThemeToggle />
        <button
          type="button"
          data-menu-close
          aria-label="Close menu"
          class="flex size-11 items-center justify-center rounded-btn border-2 border-line bg-surface text-lg font-semibold text-ink"
        >
          ×
        </button>
      </div>
      <nav aria-label="Menu">
        <ul class="m-0 list-none p-0">
          {
            links.map((l) => (
              <li class="border-b-2 border-line last:border-b-0">
                <a
                  href={l.href}
                  class:list={[
                    'flex min-h-12 items-center px-4 text-[15px] font-semibold no-underline',
                    l.on ? 'bg-accent text-on-accent hover:text-on-accent' : 'text-ink hover:bg-surface-2',
                  ]}
                >
                  [ {l.label} ]
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </WindowCard>
  </div>

  <!-- 640px+: tab row, then the icon toggle right after Contact -->
  <div class="hidden items-center gap-2 sm:flex sm:w-full lg:w-auto">
    <nav aria-label="Primary" class="flex flex-nowrap pb-0.5 pl-0.5">
      {links.map((l) => <Tab href={l.href} on={l.on} class="flex-none">{l.label}</Tab>)}
    </nav>
    <ThemeToggle />
  </div>
</header>

<script>
  // Mobile menu: opens below the header; closes on link tap, ×, Escape or tap outside.
  // (The theme toggle inside the panel doesn't close it — it isn't a link.)
  const button = document.getElementById('menu-button')!;
  const panel = document.getElementById('mobile-menu')!;

  const setOpen = (open: boolean, { restoreFocus = false } = {}) => {
    panel.hidden = !open;
    button.setAttribute('aria-expanded', String(open));
    if (open) panel.querySelector<HTMLAnchorElement>('nav a')?.focus();
    else if (restoreFocus) button.focus();
  };

  button.addEventListener('click', () => setOpen(panel.hidden));
  panel.querySelector('[data-menu-close]')!.addEventListener('click', () => setOpen(false, { restoreFocus: true }));
  panel.addEventListener('click', (e) => {
    if ((e.target as Element).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !panel.hidden) setOpen(false, { restoreFocus: true });
  });
  document.addEventListener('pointerdown', (e) => {
    const t = e.target as Node;
    if (!panel.hidden && !panel.contains(t) && !button.contains(t)) setOpen(false);
  });
  // Rotating/resizing up to the tab layout shouldn't leave a stale open panel.
  matchMedia('(min-width: 640px)').addEventListener('change', (e) => e.matches && setOpen(false));
</script>
