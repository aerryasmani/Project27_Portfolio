---
const year = new Date().getFullYear();
---

<footer class="flex flex-col gap-4">
  <div class="rule"></div>
  <div class="flex flex-col text-[13px] text-ink-2 sm:flex-row sm:flex-wrap sm:items-center sm:justify-between sm:gap-3">
    <span>© {year} Aerry Asmani · HeiyoJun</span>
    <span class="flex flex-col sm:flex-row sm:items-center sm:gap-x-2">
      <span>Made with Coffee + overthinking</span>
      <span aria-hidden="true" class="hidden sm:inline">·</span>
      <a
        href="https://github.com/aerryasmani/Project27_Portfolio/issues/new?template=bug-report.yml"
        class="inline-flex min-h-11 items-center text-ink-2">Report a bug</a
      >
    </span>
  </div>
</footer>
