---
const year = new Date().getFullYear();
const repo = 'aerryasmani/Project27_Portfolio';
const workflowUrl = `https://github.com/${repo}/actions/workflows/e2e.yml`;
// ≥24px target; inline-flex keeps the text baseline, so the link sits on the line like plain text.
const linkClass = 'inline-flex min-h-6 items-center gap-1.5 py-1 align-baseline text-ink-2';
---

<footer class="flex flex-col gap-4 max-sm:mt-6">
  <div class="rule"></div>
  <!--
    Below 1100px: one left-aligned column, 10px apart. 1100px+: grid 1fr auto 1fr (status centred).
    The three items need ~1050px to share a row with the middle one truly centred.
  -->
  <div
    class="flex flex-col items-start gap-2.5 text-xs text-ink-2 sm:text-[13px] min-[1100px]:grid min-[1100px]:grid-cols-[1fr_auto_1fr] min-[1100px]:items-center min-[1100px]:gap-4"
  >
    <p class="m-0">© {year} Aerry Asmani<span class="blink" aria-hidden="true">_</span></p>
    <!-- Server-rendered fallback; the script below swaps in the latest E2E run when the API answers. -->
    <p class="m-0 min-[1100px]:justify-self-center">
      <a id="e2e-status" href={workflowUrl} class={linkClass} data-repo={repo}>Tested with Playwright</a>
    </p>
    <!-- Each half is nowrap, so the only break is before the "·", used only when one line doesn't fit. Spaces are explicit: Astro strips inter-tag whitespace. -->
    <p class="tagline m-0 min-[1100px]:justify-self-end">
      <span class="whitespace-nowrap">Made with Coffee + overthinking</span>{' '}<span class="whitespace-nowrap"
        ><span aria-hidden="true">·</span>{' '}<a
          href={`https://github.com/${repo}/issues/new?template=bug-report.yml`}
          class={linkClass}>Report a bug</a
        ></span
      >
    </p>
  </div>
</footer>

<script>
  // Latest completed E2E run → "✓ E2E suite passing · 2 hours ago" (or failing).
  // Cached for 10 minutes per tab; any failure (offline, 403 rate limit, no runs yet) keeps the fallback.
  type Run = { conclusion: string | null; updated_at: string; html_url: string };
  const CACHE_KEY = 'e2e-status';
  const TTL = 10 * 60 * 1000;

  const link = document.getElementById('e2e-status') as HTMLAnchorElement | null;

  const relative = (iso: string) => {
    const secs = (new Date(iso).getTime() - Date.now()) / 1000;
    const rtf = new Intl.RelativeTimeFormat('en', { numeric: 'auto' });
    for (const [unit, size] of [['day', 86400], ['hour', 3600], ['minute', 60]] as const) {
      if (Math.abs(secs) >= size) return rtf.format(Math.round(secs / size), unit);
    }
    return 'just now';
  };

  const render = (run: Run) => {
    if (!link || (run.conclusion !== 'success' && run.conclusion !== 'failure')) return;
    const passing = run.conclusion === 'success';
    link.href = run.html_url;
    link.replaceChildren();
    const glyph = document.createElement('span');
    glyph.setAttribute('aria-hidden', 'true');
    glyph.textContent = passing ? '✓' : '✗';
    link.append(glyph, `E2E suite ${passing ? 'passing' : 'failing'} · ${relative(run.updated_at)}`);
  };

  const readCache = (): Run | null => {
    try {
      const raw = sessionStorage.getItem(CACHE_KEY);
      if (!raw) return null;
      const { at, run } = JSON.parse(raw);
      return Date.now() - at < TTL ? run : null;
    } catch {
      return null;
    }
  };

  const writeCache = (run: Run) => {
    try {
      sessionStorage.setItem(CACHE_KEY, JSON.stringify({ at: Date.now(), run }));
    } catch {
      /* storage unavailable — just skip caching */
    }
  };

  (async () => {
    if (!link) return;
    const cached = readCache();
    if (cached) return render(cached);
    try {
      const res = await fetch(
        `https://api.github.com/repos/${link.dataset.repo}/actions/workflows/e2e.yml/runs?per_page=1&status=completed`,
        { headers: { Accept: 'application/vnd.github+json' } },
      );
      if (!res.ok) return;
      const run: Run | undefined = (await res.json()).workflow_runs?.[0];
      if (!run) return;
      writeCache(run);
      render(run);
    } catch {
      /* network error — keep the fallback */
    }
  })();
</script>
