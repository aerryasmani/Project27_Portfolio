---
import Badge from './Badge.astro';

const year = new Date().getFullYear();
const repo = 'aerryasmani/Project27_Portfolio';
const workflowUrl = `https://github.com/${repo}/actions/workflows/e2e.yml`;
// ≥24px target; inline-flex keeps the text baseline, so the link sits on the line like plain text.
const linkClass = 'inline-flex min-h-6 items-center gap-1.5 py-1 align-baseline text-ink-2';
---

<footer class="flex flex-col gap-4 max-sm:mt-6">
  <div class="rule"></div>
  <!--
    Below 1100px: one left-aligned column, 10px apart. 1100px+: grid 1fr auto 1fr (status centred).
    The three items need ~1050px to share a row with the middle one truly centred.
  -->
  <div
    class="flex flex-col items-start gap-2.5 text-xs text-ink-2 sm:text-[13px] min-[1100px]:grid min-[1100px]:grid-cols-[1fr_auto_1fr] min-[1100px]:items-center min-[1100px]:gap-4"
  >
    <p class="m-0">© {year} Aerry Asmani<span class="blink" aria-hidden="true">_</span></p>
    <!-- E2E status: same Badge as the hero eyebrow, as a link. Server-rendered fallback (UNKNOWN);
         the script below sets the state colour, text and link from the latest run. -->
    <p class="m-0 min-[1100px]:justify-self-center">
      <Badge href={workflowUrl} id="e2e-status" data-repo={repo}>
        <span aria-hidden="true" data-square class="size-2.5 flex-none border-2 border-ink bg-surface"></span>
        <span aria-live="polite" data-text>Tested with Playwright</span>
      </Badge>
    </p>
    <!-- Each half is nowrap, so the only break is before the "·", used only when one line doesn't fit. Spaces are explicit: Astro strips inter-tag whitespace. -->
    <p class="tagline m-0 min-[1100px]:justify-self-end">
      <span class="whitespace-nowrap">Made with Coffee + overthinking</span>{' '}<span class="whitespace-nowrap"
        ><span aria-hidden="true">·</span>{' '}<a
          href={`https://github.com/${repo}/issues/new?template=bug-report.yml`}
          class={linkClass}>Report a bug</a
        ></span
      >
    </p>
  </div>
</footer>

<script>
  // Latest E2E run → state badge. Colour lives in the (aria-hidden) square; the text says the state.
  //   PASS #3FB950 · FAIL #E5534B · RUNNING / STALE / CANCELLED #F2C94C · UNKNOWN (fallback) unfilled
  // Cached per tab: 10 minutes, or 1 minute while a run is in progress. Any fetch failure keeps the fallback.
  type Run = { status: string; conclusion: string | null; updated_at: string; html_url: string };
  type State = { colour: string; text: string; href: string };

  const CACHE_KEY = 'e2e-status';
  const STALE_AFTER = 36 * 3600 * 1000; // daily schedule + slack: a missed run means stale
  const COLOURS = { pass: '#3FB950', fail: '#E5534B', warn: '#F2C94C' };

  const badge = document.getElementById('e2e-status') as HTMLAnchorElement | null;
  const square = badge?.querySelector<HTMLElement>('[data-square]');
  const label = badge?.querySelector<HTMLElement>('[data-text]');

  const ago = (iso: string) => {
    const mins = Math.floor((Date.now() - new Date(iso).getTime()) / 60000);
    if (mins < 1) return 'just now';
    if (mins < 60) return `${mins}m ago`;
    if (mins < 1440) return `${Math.floor(mins / 60)}h ago`;
    return `${Math.floor(mins / 1440)}d ago`;
  };

  const stateFor = (run: Run): State => {
    const href = run.html_url;
    if (run.status !== 'completed') return { colour: COLOURS.warn, text: 'E2E suite running…', href };
    const when = ago(run.updated_at);
    if (run.conclusion === 'failure') return { colour: COLOURS.fail, text: `E2E suite failing · ${when}`, href };
    if (run.conclusion === 'success') {
      const stale = Date.now() - new Date(run.updated_at).getTime() > STALE_AFTER;
      return stale
        ? { colour: COLOURS.warn, text: `E2E suite stale · ${when}`, href }
        : { colour: COLOURS.pass, text: `E2E suite passing · ${when}`, href };
    }
    return { colour: COLOURS.warn, text: `E2E suite cancelled · ${when}`, href }; // cancelled, timed_out, …
  };

  const render = (run: Run) => {
    if (!badge || !square || !label) return;
    const { colour, text, href } = stateFor(run);
    badge.href = href;
    square.classList.remove('border-2', 'border-ink', 'bg-surface');
    square.style.background = colour;
    label.textContent = text;
  };

  const readCache = (): Run | null => {
    try {
      const raw = sessionStorage.getItem(CACHE_KEY);
      if (!raw) return null;
      const { at, run } = JSON.parse(raw) as { at: number; run: Run };
      const ttl = run.status === 'completed' ? 10 * 60 * 1000 : 60 * 1000;
      return Date.now() - at < ttl ? run : null;
    } catch {
      return null;
    }
  };

  const writeCache = (run: Run) => {
    try {
      sessionStorage.setItem(CACHE_KEY, JSON.stringify({ at: Date.now(), run }));
    } catch {
      /* storage unavailable — just skip caching */
    }
  };

  (async () => {
    if (!badge) return;
    const cached = readCache();
    if (cached) return render(cached);
    try {
      const res = await fetch(
        `https://api.github.com/repos/${badge.dataset.repo}/actions/workflows/e2e.yml/runs?per_page=1`,
        { headers: { Accept: 'application/vnd.github+json' } },
      );
      if (!res.ok) return;
      const run: Run | undefined = (await res.json()).workflow_runs?.[0];
      if (!run) return;
      writeCache(run);
      render(run);
    } catch {
      /* network error — keep the fallback */
    }
  })();
</script>
