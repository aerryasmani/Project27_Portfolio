---
import type { HTMLAttributes } from 'astro/types';

type Props = (HTMLAttributes<'a'> & HTMLAttributes<'button'>) & {
  href?: string;
  variant?: 'primary' | 'default';
};

const { href, variant = 'default', class: className, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';

const classes = [
  'inline-flex min-h-11 items-center rounded-btn border-2 border-ink px-[18px]',
  'font-body text-[15px] font-semibold text-ink no-underline',
  'hover:text-black hover:outline-3 hover:outline-offset-2 hover:outline-accent',
  variant === 'primary' ? 'bg-accent' : 'bg-surface',
  className,
];
---

<Tag href={href} type={href ? undefined : 'button'} class:list={classes} {...rest}>[ <slot /> ]</Tag>
