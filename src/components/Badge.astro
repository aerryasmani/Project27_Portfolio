---
// Square label (radius 0). Shape rule: 0 = containers/badges, 4px = interactive, pill = skill tags (Chip).
interface Props {
  variant?: 'default' | 'accent';
  class?: string;
}

const { variant = 'default', class: className } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center gap-2 border-2 border-ink px-2.5 py-1 text-[13px] leading-none font-semibold tracking-[0.06em] whitespace-nowrap uppercase',
    variant === 'accent' ? 'bg-accent text-on-accent' : 'bg-surface text-ink',
    className,
  ]}
>
  <slot />
</span>
