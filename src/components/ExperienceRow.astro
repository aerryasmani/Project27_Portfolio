---
import type { Job } from '../data/experience';

interface Props {
  job: Job;
}

const { job } = Astro.props;
---

<li
  class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,260px),1fr))] gap-x-8 gap-y-3 border-b-2 border-ink px-5 py-[22px] last:border-b-0"
>
  <div class="flex flex-col gap-1.5">
    <span class:list={['self-start border-2 border-ink px-2 py-0.5 text-[13px] font-bold', job.current && 'bg-accent']}>
      {job.dates}
    </span>
    <span class="px text-xl">{job.company}</span>
  </div>
  <div class="flex flex-col gap-2">
    <strong class="text-base">{job.role}</strong>
    <p class="m-0 text-[15px] leading-[1.55] text-ink-body">{job.summary}</p>
  </div>
</li>
