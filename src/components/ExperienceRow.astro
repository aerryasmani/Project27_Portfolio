---
import Badge from './Badge.astro';
import type { Job } from '../data/experience';

interface Props {
  job: Job;
}

const { job } = Astro.props;
---

<li
  class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,260px),1fr))] gap-x-8 gap-y-3 border-b-2 border-ink px-4 py-5 last:border-b-0 sm:px-5 sm:py-[22px]"
>
  <div class="flex flex-col gap-1.5">
    <Badge variant={job.current ? 'accent' : 'default'} class="self-start">{job.dates}</Badge>
    <span class="text-lg font-semibold tracking-[0.04em] uppercase">{job.company}</span>
  </div>
  <div class="flex flex-col gap-2">
    <strong class="text-base font-semibold">{job.role}</strong>
    <p class="m-0 text-[15px] leading-[1.55] text-ink-body">{job.summary}</p>
  </div>
</li>
