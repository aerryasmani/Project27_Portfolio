---
interface Props {
  title: string;
  /** Render the title as a heading (h2) instead of a plain label */
  heading?: boolean;
  /** Decorative × in the title bar */
  close?: boolean;
  class?: string;
}

const { title, heading = false, close = false, class: className } = Astro.props;
const Title = heading ? 'h2' : 'span';
---

<div class:list={['pixel-shadow dither', className]}>
  <div class="lift border-2 border-ink bg-surface">
    <div class="dither flex items-center justify-between border-b-2 border-ink bg-surface-3 px-3.5 py-2.5">
      <Title class="px m-0 bg-surface-3 px-1 text-base sm:text-lg">{title}</Title>
      <slot name="badge" />
      {
        close && (
          <span
            aria-hidden="true"
            class="flex size-[22px] items-center justify-center border-2 border-ink bg-surface text-sm font-bold"
          >
            ×
          </span>
        )
      }
    </div>
    <slot />
  </div>
</div>
