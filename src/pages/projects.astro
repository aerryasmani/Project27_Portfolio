---
import Base from '../layouts/Base.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import { projects } from '../data/projects';
---

<Base
  title="Projects — Aerry Asmani"
  description="Projects by Aerry Asmani — test automation, products and design, shipped and proven."
>
  <section class="flex flex-col gap-6">
    <p class="m-0 text-sm font-bold tracking-[0.08em] text-ink-2">PROJECTS</p>
    <h1 class="px m-0 text-[clamp(40px,7vw,80px)] leading-[0.95]">ALL WORK</h1>
    <p class="m-0 max-w-[48ch] text-lg leading-normal">Design, testing, and problem-solving — shipped and proven.</p>
  </section>

  <ProjectGrid id="all-projects" title="INDEX" projects={projects} />
</Base>
