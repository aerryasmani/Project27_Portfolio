---
import Base from '../layouts/Base.astro';
import PixelButton from '../components/PixelButton.astro';
import WindowCard from '../components/WindowCard.astro';
import Stat from '../components/Stat.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ExperienceRow from '../components/ExperienceRow.astro';
import Chip from '../components/Chip.astro';
import { projects } from '../data/projects';
import { experience } from '../data/experience';
import { stack } from '../data/stack';
import { stats } from '../data/stats';
import { links } from '../data/links';
import { getPosts } from '../data/posts';

const posts = await getPosts(3);
const profile = [
  ['Name', 'Aerry Asmani'],
  ['Role', 'Senior QA Automation Engineer'],
  ['At', 'NETS Malaysia'],
];
---

<Base
  title="Aerry Asmani | Software QA Automation"
  description="Aerry Asmani, Senior QA Automation Engineer in Kuala Lumpur. Playwright, Jenkins and test infrastructure — from empty repo to green pipeline."
>
  <!-- HERO -->
  <section id="top" class="grid grid-cols-1 items-end min-[900px]:grid-cols-[1.3fr_1fr] min-[900px]:gap-16">
    <div class="flex min-w-0 flex-col gap-6">
      <p class="m-0 text-sm font-semibold tracking-[0.08em] text-ink-2">QA AUTOMATION ENGINEER · KUALA LUMPUR · GMT+8</p>
      <h1 class="px m-0 text-[clamp(40px,5vw,72px)] leading-[1.02] tracking-[-0.015em]">
        <span class="block sm:whitespace-nowrap">I break things</span>
        <span class="block sm:whitespace-nowrap">before users do<span class="text-accent">.</span></span>
      </h1>
      <p class="m-0 max-w-[52ch] text-base leading-relaxed text-balance text-ink-body sm:text-lg">
        Mostly with Playwright, CI/CD pipelines and a worrying amount of coffee.
      </p>
      <div class="grid grid-cols-2 gap-3 sm:flex sm:flex-wrap sm:gap-4">
        <PixelButton href="#work" variant="primary">View work</PixelButton>
        <PixelButton href="#contact">Get in touch</PixelButton>
      </div>
    </div>

    <WindowCard title="USER PROFILE" class="mt-8 rounded-[2px] min-[900px]:mt-0">
      <span slot="badge" class="border-2 border-ink bg-surface px-2 py-0.5 text-[13px] font-semibold">ID: HEIYOJUN</span>
      <div class="flex flex-nowrap items-center gap-[18px] p-4 max-[419px]:flex-wrap sm:p-5">
        <div class="size-[88px] flex-none border-2 border-ink bg-[#111]">
          <img src="/avatar.svg" alt="Pixel avatar" width="84" height="84" class="block size-full" />
        </div>
        <dl class="m-0 grid min-w-0 flex-1 grid-cols-[auto_minmax(0,1fr)] max-[419px]:basis-[180px] gap-x-3.5 gap-y-2 text-sm sm:text-[15px]">
          {
            profile.map(([k, v]) => (
              <>
                <dt class="text-ink-2">{k}:</dt>
                <dd class="m-0 font-semibold wrap-anywhere">{v}</dd>
              </>
            ))
          }
          <dt class="text-ink-2">Status:</dt>
          <dd class="m-0 flex min-w-0 items-center gap-2 font-semibold wrap-anywhere">
            <span aria-hidden="true" class="size-2.5 border-2 border-ink bg-pfp"></span>Building
          </dd>
        </dl>
      </div>
    </WindowCard>
  </section>

  <!-- STATS -->
  <section aria-label="Highlights" class="flex flex-col gap-5">
    <div class="rule"></div>
    <div class="grid grid-cols-2 gap-x-4 gap-y-6 sm:gap-6 min-[900px]:grid-cols-4">
      {stats.map((s) => <Stat {...s} />)}
    </div>
    <div class="rule"></div>
  </section>

  <!-- WORK -->
  <ProjectGrid id="work" title="SELECTED WORK" projects={projects} />

  <!-- EXPERIENCE -->
  <section id="experience" class="flex scroll-mt-6 flex-col gap-7">
    <SectionHeader title="EXPERIENCE">LOG</SectionHeader>
    <ol class="m-0 list-none border-2 border-ink bg-surface p-0">
      {experience.map((job) => <ExperienceRow job={job} />)}
    </ol>
  </section>

  <!-- STACK -->
  <section id="stack" class="flex scroll-mt-6 flex-col gap-7">
    <SectionHeader title="STACK"><span aria-hidden="true">■ DAILY ▒ REGULAR □ USED</span></SectionHeader>
    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,260px),1fr))] gap-x-8 gap-y-7">
      {
        stack.map((g) => (
          <div class="flex flex-col gap-3">
            <h3 class="m-0 text-sm tracking-[0.08em] text-ink-2">{g.title}</h3>
            <ul class="m-0 flex list-none flex-wrap gap-2.5 p-0">
              {g.items.map(([name, level]) => (
                <li>
                  <Chip variant={level}>{name}</Chip>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <!-- WRITING -->
  <section id="writing" class="flex scroll-mt-6 flex-col gap-7">
    <SectionHeader title="WRITING">
      <a href={links.medium} class="text-sm font-semibold">medium.com/@BukanJun →</a>
    </SectionHeader>
    <div class="flex flex-col border-t-2 border-ink">
      {
        posts.map((p) => (
          <a
            href={p.href}
            class="flex flex-wrap justify-between gap-x-6 gap-y-2 border-b-2 border-ink px-1 py-[18px] no-underline hover:bg-surface-2"
          >
            <span class="text-lg font-semibold">{p.title}</span>
            <span class="text-sm text-ink-2">
              {p.date}
              {p.minutes && ` · ${p.minutes} min`}
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="flex scroll-mt-6 justify-center">
    <WindowCard title="SYSTEM MESSAGE" heading close class="w-full max-w-[720px]">
      <div class="flex flex-col gap-5 px-4 py-6 sm:px-6 sm:py-7">
        <div class="flex items-start gap-4">
          <svg width="40" height="40" viewBox="0 0 10 10" aria-hidden="true" shape-rendering="crispEdges" class="size-8 flex-none sm:size-10">
            <path
              d="M5 0h0v1h1v2h1v2h1v2h1v2h1v1H0V9h1V7h1V5h1V3h1V1h1z"
              style="fill: var(--accent)"
              stroke="#333"
              stroke-width="0.6"></path>
            <rect x="4.5" y="3.5" width="1" height="3" style="fill: var(--on-accent)"></rect>
            <rect x="4.5" y="7.5" width="1" height="1" style="fill: var(--on-accent)"></rect>
          </svg>
          <div class="flex flex-col gap-2">
            <p class="px m-0 text-xl sm:text-[22px]">!! OPEN TO CONVERSATIONS</p>
            <p class="m-0 text-base leading-[1.55] text-ink-body">
              Senior SQA, automation lead and test-infrastructure roles — in Malaysia or remote. Response time: usually
              within 48h.
            </p>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3 sm:flex sm:flex-wrap sm:gap-3.5">
          <PixelButton href={links.email} variant="primary">Email me</PixelButton>
          <PixelButton href={links.github}>GitHub</PixelButton>
          <PixelButton href={links.linkedin}>LinkedIn</PixelButton>
          <PixelButton href={links.medium}>Medium</PixelButton>
        </div>
      </div>
    </WindowCard>
  </section>
</Base>
