---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Theme before first paint: light unless the visitor chose dark. Must stay first in <head>. -->
    <script is:inline>
      document.documentElement.dataset.theme = (() => {
        try {
          return localStorage.getItem('theme') === 'dark' ? 'dark' : 'light';
        } catch (e) {
          return 'light';
        }
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F2EEE3" />
    <script is:inline>
      document.querySelector('meta[name="theme-color"]').content =
        document.documentElement.dataset.theme === 'dark' ? '#11131C' : '#F2EEE3';
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/avatar.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <!-- Regenerate with `npm run og` (scripts/og-image.html) -->
    <meta property="og:image" content="https://heiyoaerry.one/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="I break things before users do. — Aerry Asmani, QA Automation Engineer, Kuala Lumpur" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@700&family=Geist+Mono:wght@400;500;600&display=swap"
    />
  </head>
  <body>
    <!--
      One-time boot overlay, built by JS so no-JS visitors and crawlers get the page directly.
      The page renders normally underneath; the overlay is aria-hidden and never takes focus.
    -->
    <script is:inline>
      (() => {
        try {
          const params = new URLSearchParams(location.search);
          if (
            localStorage.getItem('booted') ||
            location.hash ||
            params.has('noboot') ||
            matchMedia('(prefers-reduced-motion: reduce)').matches ||
            /bot|crawl|spider|slurp|lighthouse|pagespeed|facebookexternalhit|embedly|bingpreview/i.test(navigator.userAgent)
          )
            return;
          localStorage.setItem('booted', '1'); // set at start: a reload never replays it
        } catch (e) {
          return; // no storage → can't remember, so don't show at all
        }

        const DOTS_TO = 30; // result column
        const lines = [
          ['HEIYOAERRY BIOS v2027.10'],
          ['Checking coffee levels', 'OK'],
          ['Loading test suites', 'OK'],
          ['Mounting /portfolio', 'OK'],
          ['Bugs detected', '0'],
          ['Starting heiyoaerry.one', null],
        ];
        const el = (tag, cls, text) => {
          const n = document.createElement(tag);
          if (cls) n.className = cls;
          if (text) n.textContent = text;
          return n;
        };

        const overlay = el('div', 'boot');
        overlay.setAttribute('aria-hidden', 'true');
        lines.forEach(([label, result], i) => {
          const line = el('div', 'boot-line');
          line.style.setProperty('--i', String(i));
          line.append(label);
          if (result !== undefined && result !== null) {
            line.append(el('span', 'boot-dots', '.'.repeat(Math.max(2, DOTS_TO - label.length))), ' ', el('span', 'boot-ok', result));
          }
          if (result === null) line.append(el('span', 'blink', '_'));
          overlay.append(line);
        });
        overlay.append(el('div', 'boot-hint', '[ click or press any key to skip ]'));
        document.body.prepend(overlay);

        const SKIP = ['pointerdown', 'keydown', 'wheel', 'touchstart', 'scroll'];
        let done = false;
        const finish = () => {
          if (done) return;
          done = true;
          for (const type of SKIP) removeEventListener(type, finish, true);
          overlay.remove();
        };
        for (const type of SKIP) addEventListener(type, finish, { capture: true, passive: true });
        // Lines finish at ~900ms; fade at 1200ms (250ms, 4 steps); remove when the fade ends.
        setTimeout(() => {
          if (done) return;
          overlay.classList.add('boot-out');
          overlay.addEventListener('animationend', finish, { once: true });
          setTimeout(finish, 400); // fallback if animationend never fires
        }, 1200);
      })();
    </script>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="frame min-h-screen px-4 pt-6 pb-12 sm:px-6">
      <div class="mx-auto flex max-w-[1180px] flex-col gap-8 sm:gap-section">
        <Nav />
        <main id="main" class="flex flex-col gap-14 sm:gap-section">
          <slot />
        </main>
        <Footer />
      </div>
    </div>

    <script>
      // Same-page section links scroll (and move focus) without writing #section into the
      // address bar. Incoming deep links like /#stack still land, then the URL is tidied.
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
      const cleanUrl = () => history.replaceState(null, '', location.pathname + location.search);

      document.addEventListener('click', (e) => {
        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        const link = (e.target as Element).closest<HTMLAnchorElement>('a[href*="#"]');
        if (!link) return;
        const url = new URL(link.href);
        if (url.origin !== location.origin || url.pathname !== location.pathname || !url.hash) return;
        const target = document.getElementById(decodeURIComponent(url.hash.slice(1)));
        if (!target) return;

        e.preventDefault();
        target.scrollIntoView({ behavior: reduceMotion.matches ? 'auto' : 'smooth' });
        target.setAttribute('tabindex', '-1');
        target.focus({ preventScroll: true });
        cleanUrl();
      });

      // Land on the target ourselves (dropping the hash can cancel the browser's own
      // smooth fragment scroll mid-flight), then drop the hash.
      const tidyHash = () => {
        const target = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
        if (!target) return;
        target.scrollIntoView({ behavior: 'instant' });
        cleanUrl();
      };
      if (document.readyState === 'complete') tidyHash();
      else addEventListener('load', tidyHash, { once: true });
      addEventListener('hashchange', tidyHash);
    </script>
  </body>
</html>
